custom.el

# Local agent settings (machine-specific, never committed)
.claude/settings.local.json

# Fish secrets (exported in conf.d on shell startup, never committed)
config/fish/conf.d/secrets.fish

# Generated by OrbStack's installer; content varies per machine
config/fish/config.fish

# Generated by fish 4.3 migrations and fish_config; per-machine
config/fish/conf.d/fish_frozen_*.fish

# macOS and tooling noise
.DS_Store
__pycache__/
.lavish/

# Local Environment Variables
*.env