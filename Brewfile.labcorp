# Work (Labcorp) machine packages, on top of Brewfile.
# Activate via: DOTFILES_BREWFILE=labcorp ./install

cask "citrix-workspace", args: { appdir: "/Applications" }
cask "multipass", args: { appdir: "/Applications" }

brew "jsonnet"
brew "hugo"
brew "helm"
brew "kind"
brew "kubectx"
brew "stern"
brew "sshuttle"
brew "wget"
brew "yq"
