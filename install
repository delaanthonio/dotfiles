#!/usr/bin/env sh

# POSIX sh (not bash/zsh) so `./install` works no matter which shell invokes it.
# $0 resolves the script location when executed as ./install or via absolute path.

set -eu

CONFIG="install.conf.yaml"
DOTBOT_DIR="modules/dotbot"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "$0")" && pwd)"

cd "$BASEDIR"
git submodule update --init --recursive "$DOTBOT_DIR"

# Silence "modified: emacs.d (untracked content)" noise from Doom-generated
# files inside the submodule; real pin changes still show in git status.
git config submodule.emacs.d.ignore untracked || true

# SHELL=/bin/sh: dotbot runs shell blocks with $SHELL, which may be fish —
# the config blocks are POSIX sh and would fail under fish.
SHELL=/bin/sh "$BASEDIR/$DOTBOT_DIR/$DOTBOT_BIN" -d "$BASEDIR" -c "$CONFIG" "$@"
